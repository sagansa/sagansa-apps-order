# Template konfigurasi — ISI NILAI ASLI HANYA DI FILE LOKAL (.env / .env.playground) YANG SUDAH GITIGNORED. JANGAN PERNAH COMMIT NILAI ASLI.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

DB_AUTH_HOST=127.0.0.1
DB_AUTH_PORT=3306
DB_AUTH_DATABASE=
DB_AUTH_USERNAME=
DB_AUTH_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600
SESSION_CONNECTION=
SESSION_ENCRYPT=false
SESSION_COOKIE=sagansa_order_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
FILESYSTEM_PUBLIC_ROOT=/home/u856469756/domains/sagansa.id/admin/storage/app/public
FILESYSTEM_PUBLIC_URL=https://sagansa.id/storage

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans Configuration
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false # Set to true for production environment

VITE_WHATSAPP_ADMIN_NUMBER=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
GOOGLE_REDIRECT_URI=

# Image service (img.sagansa.id) - upload bukti pembayaran & resolve URL gambar.
# Sanctum token di-issue dari services/api (login api-ops), di-share lintas service.
IMG_SERVICE_URL=
IMAGE_SERVICE_TOKEN=
